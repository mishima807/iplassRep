@iplass:registry=https://iplass.org/nexus/repository/npm/
//iplass.org/nexus/repository/npm/:always-auth=true
# _auth の値には、連絡されたユーザ情報とパスワードを Base64 化した文字列を設定してください。
# username = user, password = pass の場合の _auth の設定例
# Base64対象  ： user:pass
# Base64文字列： dXNlcjpwYXNz
# 設定値      ： //iplass.org/nexus/repository/npm/:_auth="dXNlcjpwYXNz"
# 認証情報の漏洩を防ぐため _auth 設定値は、"~/.npmrc" (Windowsの場合、 "C:\Users\USERNAME\.npmrc") に保存することを推奨します。
//iplass.org/nexus/repository/npm/:_auth="[your_auth]"
