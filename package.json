{
  "name": "iplass-mdc",
  "private": "true",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/iplass-mdc.umd.cjs",
  "module": "./dist/iplass-mdc.js",
  "exports": {
    ".": {
      "import": "./dist/iplass-mdc.js",
      "require": "./dist/iplass-mdc.umd.cjs"
    }
  },
  "scripts": {
    "serve": "vite",
    "dev": "vite",
    "build": "npm ci && node buildvue/build.js",
    "build:dev": " node buildvue/build.js",
    "preview": "vite preview",
    "lint": "eslint src/**/*.{ts,vue} -c src/main/vue/eslint.config.mjs --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@iplass/iplass-mdc": "~4.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": ">=22",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "colors": "^1.4.0",
    "eslint": "^9.34.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^9.32.0",
    "fs-extra": "^11.3.1",
    "globals": "^16.3.0",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "~5.9.2",
    "v-lazy-show": "^0.2.4",
    "vite": "^6.0.3",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.0.6"
  },
  "engines": {
    "node": ">=22.x",
    "npm": ">=10.x"
  }
}
